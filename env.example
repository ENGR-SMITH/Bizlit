# =============================================================================
# BIZLIT — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything
# else must stay server-side (Supabase Edge Functions / your own backend) and
# must never be committed or shipped to the client.
#
# Never put real keys in THIS file — it is tracked by git. Real values belong
# in `.env.local`, which is gitignored.
#
# The app runs in DEMO MODE (sample data, no login) when the Clerk and
# Supabase values below are empty, so you can always preview the UI.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CLERK — login, sign-up and user management   https://dashboard.clerk.com
# -----------------------------------------------------------------------------
# Create an application, then: API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Keys → Secret key. SERVER ONLY — never expose this in the browser.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend API / Issuer URL, found under "Domains" (or "API Keys → Advanced").
# Paste this exact URL into Supabase → Authentication → Third-party auth → Clerk
# so Supabase can verify Clerk session tokens. Example:
#   https://your-app-name.clerk.accounts.dev
CLERK_JWT_ISSUER=https://your-app-name.clerk.accounts.dev


# -----------------------------------------------------------------------------
# 2. SUPABASE — Postgres database, storage and file uploads
#    https://supabase.com/dashboard → your project → Settings → API
# -----------------------------------------------------------------------------
# Settings → API → Project URL. Must be the HTTPS endpoint — supabase-js
# cannot use the "postgresql://..." connection string shown in Connect.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role key. SERVER ONLY. Used by scheduled jobs that
# pull supplier/competitor pages and write results. It bypasses row level
# security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → General → Reference ID (needed by the Supabase CLI for migrations)
SUPABASE_PROJECT_REF=your-project-ref

# Personal access token for the Supabase CLI — used by `supabase functions deploy`
# and `supabase db push`. Create one at
# https://supabase.com/dashboard/account/tokens. The CLI reads it only; the app
# and the Edge Functions never see it.
SUPABASE_ACCESS_TOKEN=

# Database password (Settings → Database), used by `supabase db push`/psql.
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 3. APP
# -----------------------------------------------------------------------------
# Where the app is served — used for links back from emails.
VITE_APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 4. OPTIONAL — scheduled scanning / email delivery
# -----------------------------------------------------------------------------
# Key that authorises the scheduled ingestion job (supplier + competitor scans).
SCAN_JOB_SECRET=replace-with-a-long-random-string

# Transactional email, used when the client message schedule actually sends.
# Delivered over Spacemail (Spaceship's business email) SMTP — there is no API
# key: Spacemail authenticates the SMTP session with the mailbox credentials,
# which replaces the old generic EMAIL_FROM / EMAIL_API_KEY pair.
#
# Where the credentials come from:
#   Spacemail Manager → your subscription → ⋮ → IMAP/POP3/SMTP
#   (or Spacemail Webmail → Settings → IMAP/SMTP/POP3 → See configuration)
#   SMTP settings:
#     Host: mail.spacemail.com   Port: 465   Encryption: SSL (implicit TLS)
#     Username: your full Spacemail address
#     Password: that mailbox's password
#
# SERVER ONLY — no VITE_ prefix, and real values belong in `.env.local`
# (gitignored), never in this file.
EMAIL_SMTP_HOST=mail.spacemail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
# Full Spacemail address used to log in to SMTP (e.g. no-reply@yourdomain.com)
EMAIL_SMTP_USER=
# Mailbox password / SMTP password for the address above.
EMAIL_SMTP_PASS=
# From header. Use a domain you control and publish its DKIM + SPF + DMARC
# records (Spacemail Manager → DNS) or mail providers will flag the messages.
EMAIL_FROM=BIZLIT <no-reply@yourdomain.com>
# Where bounces and replies go. Defaults to EMAIL_FROM when blank.
EMAIL_REPLY_TO=


# -----------------------------------------------------------------------------
# 5. INTEGRATIONS — SERVER ONLY
# -----------------------------------------------------------------------------
# These power the monitoring, reputation and publishing features described in
# docs/API_INTEGRATION_BLUEPRINT.md. None of them may be prefixed with VITE_:
# they are read only by Supabase Edge Functions, never by the browser. Set them
# with `supabase secrets set KEY=VALUE` or in the Supabase dashboard under
# Edge Functions → Secrets. Leave blank to keep the matching feature in demo
# mode (sample data, no live calls).
#
# SerpApi — Google organic/local/maps rankings, rich snippets and autocomplete
SERPAPI_KEY=
# Billable searches per workspace per calendar month before scans are refused.
# Defaults to 250 (SerpApi's free tier); set 0 for no cap. Searches are counted
# from api_usage_log, so the cap and the usage panel agree.
SERPAPI_MONTHLY_CAP=250

# Apify — scrape competitors' recent public social posts
APIFY_TOKEN=
# One actor per platform. Leave a platform blank and it is skipped, never guessed
# at: the gateway only sends an input whose every key and enum value it has
# verified against that actor's published schema.
#
#   instagram  apify/instagram-scraper        $0.0023 per result
#   tiktok     clockworks/tiktok-scraper      $45/month flat
#   facebook   apify/facebook-posts-scraper   $35/month flat
#   x          apidojo/tweet-scraper          $0.0001 per tweet
#
# Mind the pricing model, not just the name. A "flat per month" actor is billed a
# monthly rental rather than per result, so its price sits far above the per-run
# cap below — Apify then refuses the run (maxTotalChargeUsd covers every pricing
# model) and the platform is reported as skipped. Configuring one only makes
# sense after raising APIFY_MAX_CHARGE_USD above its monthly price and accepting
# that rental on the Apify plan.
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
APIFY_TIKTOK_ACTOR_ID=
APIFY_FACEBOOK_ACTOR_ID=
APIFY_X_ACTOR_ID=
# Cost ceilings. Per run: charged results and dollars. Per workspace per month:
# dollars before social scans are refused (defaults: 30 items, $0.25, $5.00;
# set the monthly figure to 0 for no cap).
#
# APIFY_MONTHLY_CHARGE_USD must not exceed your Apify plan's own monthly usage
# ceiling (Free is $5.00 — check Apify → Settings → Usage). Past that ceiling
# Apify stops the account outright, and a bigger number here only means the
# gateway plans spend it cannot actually place instead of trimming the run.
# Note it is a per-workspace cap read from api_usage_log: tenants sharing one
# Apify account each get this much, so keep the total within the plan.
#
# $0.25 per run is sized to the item counts below — 50 Instagram results is
# about $0.12 and 20 G2 reviews about $0.13 — and it is also what keeps a
# monthly-rental actor from ever being charged.
APIFY_MAX_ITEMS=50
APIFY_MAX_CHARGE_USD=0.25
APIFY_MONTHLY_CHARGE_USD=5
# Apify's own kill switch for a run, in seconds. Longer than the gateway's ~90s
# wait on purpose: a run we stop waiting for keeps working, and the next scan
# collects it. Keep it modest — an abandoned run still holds a concurrency slot.
APIFY_RUN_TIMEOUT_SECS=300

# Competitor website contact discovery — reads a competitor's OWN website and
# proposes the social profiles it mentions, so onboarding can fill them in for the
# user. Separate from the per-platform social actors above: this one is pointed at
# a website, not at a profile.
#
# Leave it blank and the feature reports itself unavailable — it is never guessed
# at, the way an empty per-platform actor id is not guessed at either.
#
#   vdrmota/contact-info-scraper (id 9Sk4JJhEma9vBKqrg)
#                                  $0.002 per page (primary event)
#                                  + $0.005 per GB of actor start (~4 GB default)
#                                  + $0.002 per page if a residential proxy is used
#                                  + $0.003 per page if the browser is used
#                                  + $0.001 per enriched social profile
#
# Mind the cap floor. This actor publishes `minimalMaxTotalChargeUsd: 0.5`, and
# Apify rejects a run below it with `max-total-charge-usd-below-minimum` — so it
# can NOT run under APIFY_MAX_CHARGE_USD above, and needs its own ceiling.
# A measured 3-page run cost $0.004.
#
# The id below is `vdrmota/contact-info-scraper`, verified against the live API
# (see Appendix A of docs/SOURCE_MANAGEMENT_BLUEPRINT.md) and pinned rather than
# looked up by name, so a published rename cannot silently move the feature to a
# different actor. Either form works: an actor id, or `owner~name`.
APIFY_CONTACTS_ACTOR_ID=9Sk4JJhEma9vBKqrg

# Hard ceiling for one discovery run. Must be at least the actor's own minimum
# ($0.50 today), which is exactly why it is not the shared per-run cap above.
APIFY_CONTACTS_MAX_CHARGE_USD=0.5

# Hard page ceiling, sent as the actor's own `maxRequests`. This — not
# APIFY_MAX_ITEMS — is the real cost guard: the actor bills per event, and
# maxItems does not bound a pay-per-event run.
APIFY_CONTACTS_MAX_PAGES=5

# How many links away from the start URL to crawl. 1 = the home page plus one hop,
# which is where the footer links and the /contact page usually live.
APIFY_CONTACTS_MAX_DEPTH=1

# Apify's own kill switch for a discovery run, in seconds.
APIFY_CONTACTS_RUN_TIMEOUT_SECS=120

# Keep this off. Enriching a discovered profile pulls its details and bills it as
# a separate event; social-scan already measures followers and engagement for
# real, from the platform itself.
APIFY_CONTACTS_ENRICH_PROFILES=false

# Website discovery is the one path with no workspace to bill, because onboarding
# runs before the business row exists. So the allowance is per signed-in user,
# counted from `contacts_discovery_runs`. 10/hour is generous for setup (a handful
# of competitors) and still bounds a scripted loop.
APIFY_CONTACTS_PREVIEW_MAX_PER_HOUR=10

# A stored read is reused rather than repeated inside this window, so pressing
# "Find socials from their site" twice — or reloading — cannot buy the same pages
# twice. 0 disables reuse: every click pays for a fresh read.
APIFY_CONTACTS_REUSE_WINDOW_MINUTES=2

# Supplier and competitor catalogue scans — reads a watched source's OWN site and
# records what changed (new listings, and price/stock moves where the source publishes
# them — the Suppliers page reports new listings only). This is what the
# pull-to-refresh gesture on Suppliers and Competition runs, and the only thing
# that writes supplier_items / competitor_items.
#
# Required in practice: a product-catalogue actor, one for both pages (set per
# deployment, not per target).
#
# Do NOT leave this blank expecting the contacts crawler above to cover it. That
# actor reads contact details — emails, phones, social handles — and returns
# neither product rows nor page HTML/JSON-LD, so a catalogue read through it finds
# nothing on every run while still starting, billing and reporting "succeeded" with
# 0 changes. Measured on the live project: three supplier scans completed at $0.004
# each and wrote zero rows, and supplier_items / competitor_items stayed empty with
# no error surfaced anywhere. That is the failure this variable exists to prevent,
# and it is silent, so nothing else will tell you it is happening.
#
# The actor must return flat product rows (name/title/product, price,
# availability/stock, sku, url) or schema.org JSON-LD, which most shopfronts
# already publish, and must understand `discoverProducts` so the start URL is read
# as a storefront rather than as a single product page — without it the actor
# returns the home page's <title> as a product name, which is stored because a
# name is the only field required. A row with no name is dropped rather than
# stored.
#
# Verified working: egeusta/product-data-extractor (id Sky0jZtaV0wEPFmZD, $0 to
# run, 512MB per run) — returned 12 real products with SKU, price and stock from a
# Shopify storefront. Use the bare actor ID, not the `owner/name` slug: the gateway
# calls /actors/{id}/runs with the id URI-encoded, so a slug containing a slash does
# not resolve. A site that publishes no readable robots.txt/sitemap yields 0
# products and is not charged, which is the honest outcome for a factory site with
# no shopfront behind it.
APIFY_SITE_ACTOR_ID=Sky0jZtaV0wEPFmZD

# Hard ceiling for one catalogue read. Deliberately NOT the shared
# APIFY_MAX_CHARGE_USD of $0.25: that was sized for a per-result social scrape,
# and a page-crawling actor's own minimum can sit above it, where Apify refuses
# the run outright (max-total-charge-usd-below-minimum) — a refusal, not a tighter
# cap. Raise this above the configured actor's floor.
#
# Keep this and APIFY_SITE_MAX_ITEMS small. The actor bills per product returned,
# so the two together are the price of one read, and a read happens on every pull
# for every watched source. At the old values (items 200, charge 1) a single
# Cotopaxi read cost $1.00 — its charge ceiling, hit exactly — and four of them
# spent the account's whole $5 monthly allowance. After that Apify answers every
# request with `403 Monthly usage hard limit exceeded` and six unrelated panels
# stop at once (supplier catalogues, competitor inventory, social, traffic,
# advertising), which is what makes this worth keeping tight.
APIFY_SITE_MAX_CHARGE_USD=0.3

# How many pages one read may crawl. Product listings are paginated, so the crawl
# follows links rather than stopping at the home page, and this is the reach.
APIFY_SITE_MAX_PAGES=25

# Products kept from one read — and, with the charge ceiling above, what the read
# costs. 60 is roughly $0.30. A catalogue longer than this is read from the top, so
# a change below the cut waits until something above it moves: the right way round
# for a change feed, but a ceiling to raise deliberately rather than by accident.
APIFY_SITE_MAX_ITEMS=60

# Apify's own kill switch for a catalogue read, in seconds. A run that hits it is
# still collected — a partial catalogue is a usable change feed — so this bounds
# the spend rather than the result.
APIFY_SITE_RUN_TIMEOUT_SECS=120

# Website traffic — the only producer of the traffic panels on My Business and
# Competition. Without it, `businesses.monthly_visits`, the `traffic` and
# `channel` series in `my_metrics` and the `traffic` / `traffic_source` rows in
# `competitor_metrics` are never written, so every traffic figure in the app reads
# zero and every traffic chart draws nothing.
#
# Verified working: curious_coder/similarweb-scraper (id yOYYzj2J5K88boIVO) with
# just `{ domains: [...] }` — one domain per result, returning estimated monthly
# visits, a three-month series and the channel mix. Use the bare actor ID, not the
# `owner/name` slug: the gateway calls /actors/{id}/runs with the id URI-encoded,
# and a slug containing a slash does not resolve.
#
# The figures are SimilarWeb's estimates — modelled, not counted — which is why the
# panels say "estimated". A domain the provider has no data for is reported as
# unavailable rather than stored as zero visits, because those are different facts.
APIFY_TRAFFIC_ACTOR_ID=
APIFY_TRAFFIC_MAX_CHARGE_USD=0.25
# Domains per run: your own site plus every rival's, priced together.
APIFY_TRAFFIC_MAX_DOMAINS=12
APIFY_TRAFFIC_RUN_TIMEOUT_SECS=300

# Competitor advertising — the only producer of `competitor_ads`, which is what the
# *Active ad campaigns* tile on Competition counts.
#
# Verified working: apify/facebook-ads-scraper (id JJghSZmShuco4j9gJ), pointed at an
# advertiser's own Facebook page URL with `startUrls` + `resultsLimit`. Bare actor
# ID for the same reason as above.
#
# Meta's Ad Library is only read for a competitor whose **Facebook page is saved**
# on Competition → Social presence. Its free-text search does not return the
# advertiser you asked for — a live search for *Patagonia* returned Mapu Lahual
# Chile, Rue La La and MRCOOL, and `search_type=page` returned the same set — so
# attributing those would put another company's campaigns on a competitor's profile
# and into their alerts. Competitors without a page are reported, not guessed at.
APIFY_ADS_ACTOR_ID=
APIFY_ADS_MAX_CHARGE_USD=0.5
# Ads read per advertiser, and advertisers per run.
APIFY_ADS_RESULTS_LIMIT=30
APIFY_ADS_MAX_TARGETS=10
APIFY_ADS_RUN_TIMEOUT_SECS=300

# Reviews — monitoring assembled from the readers above, not a vendor of its own.
# Google and TripAdvisor reviews are read through SerpApi (SERPAPI_KEY, engine
# google_maps_reviews / tripadvisor_reviews). The platforms below need an Apify
# actor for that platform. There is no review key of its own, and every read is
# billed to — and capped by — whichever reader served it, so the note above about
# per-result versus monthly-rental pricing applies here too.
#
#   yelp        web_wanderer/yelp-reviews-scraper       $0.0003 per review
#   g2          zen-studio/g2-reviews-scraper           $0.0065 per review
#   capterra    azzouzana/capterra-reviews-scraper      $0.001 per result
#   trustpilot  casper11515/trustpilot-reviews-scraper  $40/month flat
APIFY_TRUSTPILOT_REVIEWS_ACTOR_ID=
APIFY_YELP_REVIEWS_ACTOR_ID=
APIFY_G2_REVIEWS_ACTOR_ID=
APIFY_CAPTERRA_REVIEWS_ACTOR_ID=
# Sending replies needs your own Google Business Profile connected through OAuth:
# Google only accepts replies to review ids it issued itself, so a scraped id
# cannot be replied to. Leave both blank until that connection exists — the reply
# composer still works for copy-and-paste replies.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mallary.ai — publish finished ad designs to the user's social accounts
MALLARY_API_KEY=
# Posts per workspace per calendar month before publishing is refused.
# Defaults to 50; set 0 for no cap.
MALLARY_MONTHLY_CAP=50
# API base URL. Defaults to https://mallary.ai when unset.
MALLARY_BASE_URL=
# Secret Mallary signs its webhooks with (post.scheduled / post.published /
# post.partial / post.failed). Falls back to INTEGRATIONS_WEBHOOK_SECRET.
MALLARY_WEBHOOK_SECRET=

# AI drafting (the `ai-draft` function) — reply drafts, ad angles and keyword
# themes. Every draft is something a user edits and confirms; nothing is ever
# sent, posted or created by the model.
#
# Only this key has to be set. Without it the three drafting surfaces answer 409
# and the app tells you which variable to add.
GROQ_API_KEY=
# Model that writes the drafts. Groq's production-tier 120B model by default.
# NOTE: llama-3.3-70b-versatile is Enterprise-only now, so it is not a drop-in
# replacement on a developer plan. openai/gpt-oss-20b is the cheaper alternative.
LLM_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint works here, which is the whole swap story: point
# this at another provider and only the key below needs to change.
LLM_BASE_URL=https://api.groq.com/openai/v1
# The rates usage is costed from, per 1M tokens — the defaults are gpt-oss-120b's
# published prices. Update them if you change the model or endpoint.
LLM_INPUT_USD_PER_MTOK=0.15
LLM_OUTPUT_USD_PER_MTOK=0.6
# Monthly ceiling in dollars per workspace. Leave blank (the default) to log
# drafting without ever refusing it: a call costs a fraction of a cent, so the
# guardrail here is that a person has to ask for each one. Set a number to switch
# the same cap enforcement the other providers use on as well.
LLM_MONTHLY_CHARGE_USD=

# Fallback secret for verifying inbound provider webhooks, used only when
# MALLARY_WEBHOOK_SECRET above is blank — so set one or the other, not both.
# It exists for a second provider that signs with a different secret.
INTEGRATIONS_WEBHOOK_SECRET=

# Public URL of the deployed `provider-webhook` function, passed to Mallary as the
# completion callback so publishing status arrives without polling. Leave blank to
# rely on the short built-in poll for immediate posts.
INTEGRATIONS_WEBHOOK_URL=
